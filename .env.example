# OKX API 配置
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET_KEY=your_okx_secret_key_here
OKX_PASSPHRASE=your_okx_passphrase_here
OKX_SANDBOX=false

# Binance API 配置
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_TESTNET=false

# Hyperliquid API 配置
HYPERLIQUID_API_KEY=your_hyperliquid_api_key_here
HYPERLIQUID_SECRET_KEY=your_hyperliquid_secret_key_here

# 套利配置
MIN_PROFIT_THRESHOLD=0.5

# 自动交易配置
ENABLE_AUTO_TRADE=false
AUTO_TRADE_DRY_RUN=true
ORDER_USDT_SIZE=50
AUTO_TRADE_MIN_PROFIT=0.5
AUTO_TRADE_COOLDOWN_MS=15000
MAX_SLIPPAGE_PCT=0.5

# 监控交易对（逗号分隔，用于 realtime_monitor / 基差套利等脚本）
ARBITRAGE_SYMBOLS=BTC-USDT,ETH-USDT,SOL-USDT

# OKX 现货-永续基差套利
BASIS_HOLD_HOURS=8
BASIS_MIN_PROFIT=0.2
BASIS_STOP_LOSS_PCT=0
BASIS_TAKE_PROFIT_PCT=0
OKX_SPOT_FEE=0.001
OKX_PERP_FEE=0.0005

# 年化守护策略
TARGET_APR_MIN=10
EXIT_APR_MIN=2
STOP_LOSS_PCT=0
TAKE_PROFIT_PCT=0

# 管理器 / 采样器
MANAGER_CHECK_INTERVAL_MS=60000
MANAGER_RUN_MS=0
FUNDING_CLOSE_BEFORE_MINUTES=5
SAMPLER_INTERVAL_MS=3000
SAMPLER_RUN_MS=0

# 实时监控
CHECK_INTERVAL=2000
PRICE_CACHE_TTL=10000
MAX_OPPORTUNITY_AGE=30000

# 说明:
# 1. 复制此文件为 .env 并填入真实的API密钥
# 2. OKX_SANDBOX: 设置为 true 使用沙盒环境
# 3. BINANCE_TESTNET: 设置为 true 使用测试网络
# 4. Hyperliquid API密钥: 从Hyperliquid平台获取
# 5. MIN_PROFIT_THRESHOLD: 最小利润阈值（百分比），低于此值的机会将被过滤
# 6. 请确保API密钥具有适当的权限（读取与交易权限）
# 7. AUTO_TRADE_DRY_RUN=true 时不会真的下单，仅打印计划
# 8. 为了安全，请不要将 .env 文件提交到版本控制系统