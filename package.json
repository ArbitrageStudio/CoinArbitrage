{
  "name": "coin-arbitrage",
  "version": "1.0.0",
  "description": "Cryptocurrency arbitrage tool for comparing prices between OKX and Binance",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "monitor": "node scripts/realtime_monitor.js",
    "dryrun": "node scripts/dry_run_demo.js",
    "basis:dryrun": "node scripts/okx_basis_dryrun.js",
    "basis:sandbox": "node scripts/okx_basis_trade.js",
    "basis:close": "node scripts/okx_basis_close.js",
    "basis:risk": "node scripts/okx_basis_risk.js",
    "basis:manager": "node scripts/okx_basis_manager.js",
    "basis:yield": "node scripts/yield_guard.js",
    "arb:advanced": "node scripts/advanced_arbitrage_cli.js",
    "arb:stat": "node scripts/stat_arb_sampler.js",
    "lighter:wsdemo": "node scripts/lighter_ws_demo.js",
    "test": "node test/test_arbitrage.js && node test/test_advanced_arbitrage.js"
  },
  "keywords": [
    "cryptocurrency",
    "arbitrage",
    "okx",
    "binance",
    "trading",
    "price-comparison"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.0",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
